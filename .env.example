# Copy to an untracked, permission-restricted environment file and replace values.
# No real credentials, database target or filesystem identity is supplied here.
DATABASE_URL=postgresql://gallery_app:REPLACE_WITH_URL_ENCODED_PASSWORD@database.example.invalid:5432/gallery
MEDIA_STORAGE_ROOT=/srv/gallery-media
MEDIA_STORAGE_UUID=REPLACE_WITH_FILESYSTEM_UUID
MEDIA_STORAGE_ID=REPLACE_WITH_INSTALLATION_UUID

# required (default): lookup failure rejects import; best-effort: import without
# location on service failure; disabled: no requests and no URL required.
GEOCODER_MODE=disabled
# To enable, set the full Nominatim-compatible reverse endpoint, without a query.
# GEOCODER_URL=https://geocoder.example.invalid/reverse
GEOCODER_TIMEOUT_MS=10000

# M13 defaults. Positive decimal integers; byte values use binary MiB/GiB.
MEDIA_MAX_UPLOAD_BYTES=536870912
MEDIA_MAX_REQUEST_BYTES=536936448
MEDIA_MAX_CONCURRENT_JOBS=2
MEDIA_MAX_SUBPROCESSES=2
MEDIA_MAX_TEMP_BYTES=2147483648
MEDIA_MIN_FREE_BYTES=1073741824
MEDIA_UPLOAD_TIMEOUT_MS=120000
MEDIA_SUBPROCESS_TIMEOUT_MS=60000
MEDIA_SUBPROCESS_OUTPUT_BYTES=1048576
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_MAX_THUMBNAIL_BYTES=16777216

# Next defaults to port 3000. Set PORT in the service environment (not this .env
# file), or pass --port. Bind explicitly using next start --hostname.
# PORT=3000
# Never set NEXT_PUBLIC_DATABASE_URL or put secrets in NEXT_PUBLIC_* variables.
# GALLERY_MIGRATION_URL and MEDIA_RECOVERY_DATABASE_URL belong only in the
# separate maintenance environment; do not grant the application DDL privileges.

# JSON API request bounds (multipart uploads retain MEDIA_* limits).
API_JSON_MAX_BYTES=4096
API_JSON_BULK_MAX_BYTES=65536
API_JSON_TIMEOUT_MS=10000
API_JSON_MAX_IDS=500
API_JSON_MAX_DEPTH=4
API_JSON_MAX_NODES=2048
